{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/img/:d/:i", "destination": "/api/product-image?d=:d&i=:i" },
    { "source": "/p/:id", "destination": "/api/product-page?id=:id" },
    { "source": "/site-img/:d", "destination": "/api/site-image?d=:d" }
  ],
  "functions": {
    "api/product-page.js": { "includeFiles": "data/products.js" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
